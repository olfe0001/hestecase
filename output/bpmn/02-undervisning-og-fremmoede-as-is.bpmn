<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_02-undervisning-og-fremmoede-as-is" targetNamespace="https://boegegaarden.example/bpmn" exporter="Project draft generator">
  <bpmn:collaboration id="Collab">
    <bpmn:participant id="Pool" name="Bøgegården" processRef="Process" />
  </bpmn:collaboration>
  <bpmn:process id="Process" name="AS-IS · Undervisning og fremmøde" isExecutable="false">
    <bpmn:documentation>To baner i én fælles proces: Ridelærere og Elever. Kilder: SIPOC trin 5-7, case og interview. A2: akut ændring. A3: eleven klargør med støtte. A4: fremmøde følger SIPOC-rækkefølge. Se laes-mig.md.</bpmn:documentation>
    <bpmn:laneSet id="Lanes">
      <bpmn:lane id="Teacher" name="Ridelærere">
        <bpmn:flowNodeRef>Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Read</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Available</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Reassign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Teach</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Attend</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Students" name="Elever">
        <bpmn:flowNodeRef>Prepare</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start" name="Forberedelse til hold">
      <bpmn:documentation>Én instans pr. hold. Læreren møder 30 minutter før dagens første hold.</bpmn:documentation>
      <bpmn:outgoing>F1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Read" name="Se holdliste og beskeder">
      <bpmn:documentation>Case: fysisk mappe, SMS og whiteboard. A2: samlet læsetrin antages.</bpmn:documentation>
      <bpmn:incoming>F1</bpmn:incoming>
      <bpmn:outgoing>F2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Available" name="Behov for hesteskift?" gatewayDirection="Diverging">
      <bpmn:documentation>A2: opdaget sygdom eller andet behov udløser manuel omfordeling.</bpmn:documentation>
      <bpmn:incoming>F2</bpmn:incoming>
      <bpmn:outgoing>F3</bpmn:outgoing>
      <bpmn:outgoing>F4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Reassign" name="Omfordel og ret dagens liste">
      <bpmn:documentation>A2: forudsætter egnet erstatningshest; praksis uden erstatning er uafklaret.</bpmn:documentation>
      <bpmn:incoming>F4</bpmn:incoming>
      <bpmn:outgoing>F5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Prepare" name="Gør hesten klar med hjælp efter behov">
      <bpmn:documentation>Case: elever/forældre gør hesten klar; staldhjælpere støtter efter behov. A3: støtteroller vises ikke i egne baner.</bpmn:documentation>
      <bpmn:incoming>F3</bpmn:incoming>
      <bpmn:incoming>F5</bpmn:incoming>
      <bpmn:outgoing>F6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Teach" name="Afvikl undervisning med eleverne">
      <bpmn:documentation>SIPOC trin 6. Opgaven sammenfatter undervisning og elevdeltagelse; ingen særskilt sekventiel deltagelsesopgave.</bpmn:documentation>
      <bpmn:incoming>F6</bpmn:incoming>
      <bpmn:outgoing>F7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Attend" name="Registrér fremmøde">
      <bpmn:documentation>SIPOC trin 7. A4: tidspunkt efter undervisning skal bekræftes.</bpmn:documentation>
      <bpmn:incoming>F7</bpmn:incoming>
      <bpmn:outgoing>F8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End" name="Hold afviklet og fremmøde noteret">
      <bpmn:documentation>Lokal registrering er ikke automatisk afstemning med kontoret.</bpmn:documentation>
      <bpmn:incoming>F8</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F1" sourceRef="Start" targetRef="Read" />
    <bpmn:sequenceFlow id="F2" sourceRef="Read" targetRef="Available" />
    <bpmn:sequenceFlow id="F3" sourceRef="Available" targetRef="Prepare" name="Nej" />
    <bpmn:sequenceFlow id="F4" sourceRef="Available" targetRef="Reassign" name="Ja" />
    <bpmn:sequenceFlow id="F5" sourceRef="Reassign" targetRef="Prepare" />
    <bpmn:sequenceFlow id="F6" sourceRef="Prepare" targetRef="Teach" />
    <bpmn:sequenceFlow id="F7" sourceRef="Teach" targetRef="Attend" />
    <bpmn:sequenceFlow id="F8" sourceRef="Attend" targetRef="End" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram" name="AS-IS · Undervisning og fremmøde">
    <bpmndi:BPMNPlane id="Plane" bpmnElement="Collab">
      <bpmndi:BPMNShape id="Shape_Pool" bpmnElement="Pool" isHorizontal="true" bioc:fill="#ffffff" bioc:stroke="#64748b">
        <dc:Bounds x="70" y="190" width="1900" height="620" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Teacher" bpmnElement="Teacher" isHorizontal="true" bioc:fill="#eff6ff" bioc:stroke="#93c5fd">
        <dc:Bounds x="100" y="190" width="1870" height="350" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Students" bpmnElement="Students" isHorizontal="true" bioc:fill="#f0fdf4" bioc:stroke="#86efac">
        <dc:Bounds x="100" y="540" width="1870" height="270" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Start" bpmnElement="Start" bioc:fill="#dcfce7" bioc:stroke="#15803d">
        <dc:Bounds x="150" y="302" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="100" y="346" width="136" height="45" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Read" bpmnElement="Read" bioc:fill="#dbeafe" bioc:stroke="#2563eb">
        <dc:Bounds x="245" y="280" width="180" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Available" bpmnElement="Available" isMarkerVisible="true" bioc:fill="#fef3c7" bioc:stroke="#b45309">
        <dc:Bounds x="485" y="295" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="435" y="353" width="150" height="45" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Reassign" bpmnElement="Reassign" bioc:fill="#dbeafe" bioc:stroke="#2563eb">
        <dc:Bounds x="580" y="435" width="180" height="65" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Prepare" bpmnElement="Prepare" bioc:fill="#dcfce7" bioc:stroke="#16a34a">
        <dc:Bounds x="850" y="620" width="190" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Teach" bpmnElement="Teach" bioc:fill="#dbeafe" bioc:stroke="#2563eb">
        <dc:Bounds x="1120" y="280" width="180" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Attend" bpmnElement="Attend" bioc:fill="#dbeafe" bioc:stroke="#2563eb">
        <dc:Bounds x="1370" y="280" width="180" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End" bpmnElement="End" bioc:fill="#dcfce7" bioc:stroke="#15803d">
        <dc:Bounds x="1690" y="302" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1640" y="346" width="136" height="45" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Edge_F1" bpmnElement="F1">
        <di:waypoint x="186" y="320" />
        <di:waypoint x="245" y="320" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_F2" bpmnElement="F2">
        <di:waypoint x="425" y="320" />
        <di:waypoint x="485" y="320" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_F3" bpmnElement="F3">
        <di:waypoint x="535" y="320" />
        <di:waypoint x="790" y="320" />
        <di:waypoint x="790" y="660" />
        <di:waypoint x="850" y="660" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="597.5" y="296.0" width="130" height="35" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_F4" bpmnElement="F4">
        <di:waypoint x="510" y="345" />
        <di:waypoint x="510" y="467.5" />
        <di:waypoint x="580" y="467.5" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="445.0" y="382.25" width="130" height="35" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_F5" bpmnElement="F5">
        <di:waypoint x="760" y="467.5" />
        <di:waypoint x="815" y="467.5" />
        <di:waypoint x="815" y="660" />
        <di:waypoint x="850" y="660" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_F6" bpmnElement="F6">
        <di:waypoint x="1040" y="660" />
        <di:waypoint x="1210" y="660" />
        <di:waypoint x="1210" y="360" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_F7" bpmnElement="F7">
        <di:waypoint x="1300" y="320" />
        <di:waypoint x="1370" y="320" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_F8" bpmnElement="F8">
        <di:waypoint x="1550" y="320" />
        <di:waypoint x="1690" y="320" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>