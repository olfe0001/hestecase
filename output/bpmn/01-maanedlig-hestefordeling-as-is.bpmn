<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_01-maanedlig-hestefordeling-as-is" targetNamespace="https://boegegaarden.example/bpmn" exporter="Project draft generator">
  <bpmn:collaboration id="Collab">
    <bpmn:participant id="Pool" name="Bøgegården" processRef="Process" />
  </bpmn:collaboration>
  <bpmn:process id="Process" name="AS-IS · Månedlig hestefordeling" isExecutable="false">
    <bpmn:documentation>To baner i én fælles proces: Ridelærere og Elever. Kilder: SIPOC trin 1-4, case s. 2-4 og interview. A1: konfliktkontrol og omarbejde kræver bekræftelse. Se laes-mig.md.</bpmn:documentation>
    <bpmn:laneSet id="Lanes">
      <bpmn:lane id="Teacher" name="Ridelærere">
        <bpmn:flowNodeRef>Collect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Match</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Conflict</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Adjust</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>List</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_1eoumw2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Students" name="Elever">
        <bpmn:flowNodeRef>Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Wish</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_0uct98k</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start" name="Sidste ridetime i måneden">
      <bpmn:documentation>Case s. 2. Én proces dækker lærerens månedsfordeling; elevbanen sammenfatter elevernes bidrag.</bpmn:documentation>
      <bpmn:outgoing>F1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Wish" name="Aflever op til tre hesteønsker">
      <bpmn:documentation>Case og interview: elever afgiver ønsker. Forældre kan støtte eleven.</bpmn:documentation>
      <bpmn:incoming>F1</bpmn:incoming>
      <bpmn:outgoing>F2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Collect" name="Indsaml og notér hesteønsker">
      <bpmn:documentation>SIPOC trin 1. Ønsker noteres på telefon.</bpmn:documentation>
      <bpmn:incoming>F2</bpmn:incoming>
      <bpmn:outgoing>F3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Check" name="Tjek tilgængelighed og belastning">
      <bpmn:documentation>SIPOC trin 2. Manuel vurdering ud fra lister, whiteboard og tavs viden; casens velfærdsregler gælder.</bpmn:documentation>
      <bpmn:incoming>F3</bpmn:incoming>
      <bpmn:incoming>F8</bpmn:incoming>
      <bpmn:outgoing>F4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Match" name="Match og fordel heste">
      <bpmn:documentation>SIPOC trin 3. Manuel fordeling med elevhensyn og ønsker.</bpmn:documentation>
      <bpmn:incoming>F4</bpmn:incoming>
      <bpmn:outgoing>F5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Conflict" name="Opdages konflikt?" gatewayDirection="Diverging">
      <bpmn:documentation>A1: eksplicit kontrol og omarbejde er en modelleringsantagelse.</bpmn:documentation>
      <bpmn:incoming>F5</bpmn:incoming>
      <bpmn:outgoing>F6</bpmn:outgoing>
      <bpmn:outgoing>F7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Adjust" name="Ret fordelingen">
      <bpmn:documentation>A1: manuel rettelse og fornyet vurdering. Praksis ved uløselig fordeling er uafklaret.</bpmn:documentation>
      <bpmn:incoming>F7</bpmn:incoming>
      <bpmn:outgoing>F8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="List" name="Print og opdater holdlister">
      <bpmn:documentation>SIPOC trin 4. Print og fysisk mappe; ingen automatisk afstemning med kontoret.</bpmn:documentation>
      <bpmn:incoming>F6</bpmn:incoming>
      <bpmn:outgoing>F9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="F1" sourceRef="Start" targetRef="Wish" />
    <bpmn:sequenceFlow id="F2" sourceRef="Wish" targetRef="Collect" />
    <bpmn:sequenceFlow id="F3" sourceRef="Collect" targetRef="Check" />
    <bpmn:sequenceFlow id="F4" sourceRef="Check" targetRef="Match" />
    <bpmn:sequenceFlow id="F5" sourceRef="Match" targetRef="Conflict" />
    <bpmn:sequenceFlow id="F6" name="Nej" sourceRef="Conflict" targetRef="List" />
    <bpmn:sequenceFlow id="F7" name="Ja" sourceRef="Conflict" targetRef="Adjust" />
    <bpmn:sequenceFlow id="F8" sourceRef="Adjust" targetRef="Check" />
    <bpmn:sequenceFlow id="F9" sourceRef="List" targetRef="Activity_1eoumw2" />
    <bpmn:task id="Activity_1eoumw2" name="Ridelære afleverer holdlisterne i mappen">
      <bpmn:documentation>SIPOC trin 4. Print og fysisk mappe; ingen automatisk afstemning med kontoret.</bpmn:documentation>
      <bpmn:incoming>F9</bpmn:incoming>
      <bpmn:outgoing>Flow_08l5zio</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="Flow_08l5zio" sourceRef="Activity_1eoumw2" targetRef="Activity_0uct98k" />
    <bpmn:endEvent id="Activity_0uct98k" name="Elever ved hvilken hest de får">
      <bpmn:incoming>Flow_08l5zio</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
