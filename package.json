{
  "name": "stald-hestecase",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": ["client", "server"],
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "concurrently -n api,web -c green,blue \"npm run dev --workspace server\" \"npm run dev --workspace client\"",
    "build": "npm run build --workspace client",
    "start": "npm run start --workspace server",
    "check": "npm run build && node --check server/index.js"
  },
  "devDependencies": { "concurrently": "^9.2.1" }
}
